# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Generated documents are working artifacts, not source.
# Commit them only if your team has decided to review docs in git.
output/*
!output/README.md

# MCP client configuration. These files hold credentials when an assistant is
# configured with an API token instead of OAuth, and a committed token stays in
# git history after you delete it. Ignored by default; force-add a token-free one
# only if you are certain it carries no secret.
.mcp.json
.vscode/mcp.json
opencode.json
.env
.env.*
!.env.example
